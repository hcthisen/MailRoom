# Copy to .env and fill in. NEVER share .env with anyone and never commit it to git.
#
# This file stays on your own machine. The coding agent copies only the
# "You / sender" block and AWS_REGION into the server's settings file
# (/opt/mailroom/.env). The keys below it are setup keys: they are used for
# single setup commands and never stored on the server.
#
# Don't add anything else here. The server's settings file also gets values
# that only exist there, which the agent and Mailroom write themselves:
# the sending user's AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY (a different
# key from yours below), SNS_TOPIC_ARN, SES_CONFIGURATION_SET and
# BACKUP_BUCKET, plus optional server settings (HTTP_ONLY, HTTP_ADDR,
# TRUSTED_PROXIES, BASE_URL, MAILROOM_SECRET, MAILROOM_LOG_LEVEL,
# MAILROOM_VERSION, MAILROOM_UID, MAILROOM_GID). See deploy/README.md.

# --- You / sender (step 5; copied to the server) ---------------------------
DOMAIN=yourdomain.com                    # Your ONE sending domain
FROM_NAME="Your Company"
FROM_EMAIL=newsletter@yourdomain.com     # Must be on DOMAIN
REPLY_TO_EMAIL=contact@yourdomain.com    # Must be on DOMAIN
COMPANY_FOOTER="Your Company Ltd · 1 Street, 1234 City · Reg. no. 12345678"
OWNER_EMAIL=you@yourdomain.com           # Test emails, certificates and alerts (best on DOMAIN)
TIMEZONE=Europe/Copenhagen
APP_SUBDOMAIN=newsletter                 # Mailroom runs at newsletter.yourdomain.com
MAIL_FROM_SUBDOMAIN=bounce               # -> bounce.yourdomain.com (SES custom MAIL FROM)

# --- GoHighLevel (step 1; this machine only) --------------------------------
GHL_TOKEN=
GHL_LOCATION_ID=
GHL_CONTACT_COUNT=                       # Number of contacts GHL shows in the UI
GHL_SHUTDOWN_DATE=YYYY-MM-DD

# --- AWS (step 2) -----------------------------------------------------------
AWS_ACCESS_KEY_ID=                       # The setup-agent user's key (step 2.7): setup only
AWS_SECRET_ACCESS_KEY=                   # Setup only, never copied to the server
AWS_REGION=eu-central-1                  # Copied to the server

# --- Where Mailroom runs (step 3; this machine only) -----------------------
DEPLOY_TARGET=vps                        # vps (own server) | coolify (existing Coolify server)

# vps: a Hetzner token OR your own server

HCLOUD_TOKEN=
HCLOUD_LOCATION=fsn1                     # fsn1/nbg1 (Germany) or hel1 (Finland)
VPS_HOST=                                # Only if you use your own server
VPS_SSH_USER=                            # Only if you use your own server

# coolify: leave both empty if you click through Coolify yourself (deploy/coolify.md)
COOLIFY_URL=                             # e.g. https://coolify.example.com
COOLIFY_API_TOKEN=                       # Keys & Tokens -> API tokens (write access): setup only

# --- DNS (step 4; this machine only) ----------------------------------------
DNS_MODE=cloudflare                      # cloudflare | manual
CLOUDFLARE_API_TOKEN=                    # Only with DNS_MODE=cloudflare: setup only
